{
  "name": "dyna-tool-desktop",
  "version": "0.1.0",
  "productName": "Dyna",
  "private": true,
  "description": "Electron and React desktop interface for Dyna Tool",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json --noEmit && vite build",
    "lint": "eslint src vite.config.ts electron --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@tanstack/react-virtual": "^3.14.7",
    "lucide-react": "^0.468.0",
    "opencc-js": "^1.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.dynatool.desktop",
    "productName": "Dyna",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend/DynaBackend",
        "to": "backend"
      },
      {
        "from": "build/playwright-driver",
        "to": "playwright-driver"
      },
      {
        "from": "../image/dyna-app-icon.ico",
        "to": "image/dyna-app-icon.ico"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "../image/dyna-app-icon.ico",
      "artifactName": "Dyna-${version}-portable.${ext}"
    }
  }
}
