# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
DB_NAME=dynatool

# ── SePay Webhook Secret ──────────────────────────────────────────────────────
# Lấy từ SePay Dashboard > Webhook > API Key (Bước 3: Bảo mật = API Key)
# URL trên SePay (phải public, không dùng localhost):
#   https://YOUR-DOMAIN/payment/webhook
# Dev local: dùng ngrok http 8000 → https://xxxx.ngrok-free.app/payment/webhook
SEPAY_WEBHOOK_SECRET=whsec_dynatool_2026

# ── MB Bank Info ──────────────────────────────────────────────────────────────
BANK_ID=MB
BANK_ACCOUNT_NO=0374269710
BANK_ACCOUNT_NAME=LE QUOC BAO

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:8000
# Comma-separated CORS origins (optional; defaults to SERVER_URL + localhost)
# CORS_ORIGINS=https://your-domain.com,http://localhost:3000
DEBUG=false

# ── Order Expiry (phút) ───────────────────────────────────────────────────────
ORDER_EXPIRY_MINUTES=30

# ── Admin panel (http://localhost:8000/admin/login) ───────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_2026
ADMIN_SECRET_KEY=your_random_secret_key_at_least_32_chars
